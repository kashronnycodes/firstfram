# Browser/API
VITE_API_BASE_URL=http://localhost:8787
VITE_MAX_FILE_SIZE_BYTES=536870912
VITE_MAX_BATCH_SIZE_BYTES=2147483648
API_PORT=8787
CLIENT_ORIGIN=http://localhost:8443
SESSION_SECRET=replace-with-at-least-32-random-characters
SECURE_COOKIES=false

# Supabase (service role keys are server/worker only; never prefix them with VITE_)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SOURCE_VIDEO_BUCKET=source-videos
OUTPUT_FRAME_BUCKET=output-frames

# Safe configurable limits
MAX_FILE_SIZE_BYTES=536870912
MAX_BATCH_SIZE_BYTES=2147483648
MAX_VIDEO_DURATION_SECONDS=3600
MAX_JOBS_PER_SESSION_PER_DAY=100
MAX_JOBS_PER_IP_PER_DAY=200
ALLOWED_VIDEO_CODECS=h264,hevc,vp8,vp9,av1,prores,mpeg4

# Retention and worker
RETENTION_HOURS=24
PREVIEW_URL_TTL_SECONDS=300
WORKER_POLL_MS=1500
FFMPEG_TIMEOUT_MS=900000
# WORKER_TEMP_ROOT=C:\firstframe-temp
