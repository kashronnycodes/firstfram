{
  "name": "figma-make-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:api": "tsx watch server/index.ts",
    "dev:worker": "tsx watch worker/index.ts",
    "start:api": "node build/server/index.js",
    "start:worker": "node build/worker/index.js",
    "cleanup": "tsx worker/cleanup.ts",
    "build": "vite build",
    "build:server": "tsc -p tsconfig.node-build.json",
    "build:all": "pnpm run build && pnpm run build:server",
    "preview": "vite preview",
    "format": "oxfmt --threads=1 src server worker shared vite.config.ts vitest.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.server.json && tsc --noEmit -p tsconfig.json",
    "test": "vitest run --configLoader runner",
    "test:smoke": "vitest run --configLoader runner worker/__tests__/ffmpeg.smoke.test.ts"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "@supabase/supabase-js": "^2.57.4",
    "archiver": "^7.0.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/archiver": "^6.0.3",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-react": "^6.0.0",
    "supertest": "^7.1.4",
    "tailwindcss": "^4.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "oxfmt": "^0.2.0",
    "tsx": "^4.20.5",
    "typescript": "^5.7.0",
    "vite": "^8.0.0",
    "vitest": "^3.2.4"
  }
}
